# ChromaDB Cloud (vector storage — required for all RAG operations)
CHROMA_API_KEY=your_key_here
CHROMA_TENANT=your_tenant_here
CHROMA_DATABASE=your_database_here

# OpenRouter (conversation summarisation — required after 16 messages)
OPENROUTER_KEY=your_key_here

# --- Only needed to re-run the ingestion pipeline (not required for pentesting) ---
# UNSTRUCTURED_API_KEY=your_key_here
# UNSTRUCTURED_API_URL=https://api.unstructuredapp.io/general/v0/general
